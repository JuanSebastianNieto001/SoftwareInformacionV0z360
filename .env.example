# ---------------------------------------------------------------------------
# Gestor Documental Interno — variables de entorno
# Copia este archivo a .env.local (desarrollo) y configura las mismas
# variables en Vercel (Settings > Environment Variables) para producción.
# ---------------------------------------------------------------------------

# URL del proyecto de Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon key). Es segura de exponer al navegador: RLS manda.
# Si tu proyecto usa las claves nuevas, pega aquí la "publishable key" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role. SOLO SERVIDOR. Nunca con prefijo NEXT_PUBLIC_.
# Se usa únicamente en Route Handlers (app/api/**) y en la Edge Function.
# Si tu proyecto usa las claves nuevas, pega aquí la "secret key" (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# Secreto que Vercel Cron envía en el header Authorization: Bearer <CRON_SECRET>
# al invocar /api/cron/purgar. Genera uno con: openssl rand -hex 32
CRON_SECRET=

# URL pública de la aplicación (sin barra final). Se usa en metadatos y correos.
NEXT_PUBLIC_APP_URL=http://localhost:3000
